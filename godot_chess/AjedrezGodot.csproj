<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!--
    Archivo de proyecto .NET para Godot 4.7.2.
    Configurado con net8.0 (compatible con exportacion Android ARMv7 32-bit y ARM64 64-bit),
    tipos anulables habilitados para prevenir NullReferenceException y compilacion determinista.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AjedrezGodot</RootNamespace>
    <AssemblyName>AjedrezGodot</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
