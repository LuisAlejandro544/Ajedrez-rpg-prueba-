[node name="RulesText" type="Label" parent="CenterContainer/PanelContainer/VBoxContainer/ScrollContainer"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.92, 0.88, 0.82, 1)
theme_override_font_sizes/font_size = 19
text = "1. Objetivo: Dar jaque mate al rey enemigo evitando que nuestro rey quede bajo ataque.

2. Enroque (O-O / O-O-O): El rey avanza dos casillas hacia una torre sin haber movido antes ninguno de los dos, sin piezas en medio, y sin estar ni pasar por casillas en jaque.

3. Captura al paso (En Passant): Si un peon avanza dos casillas desde su fila inicial y queda junto a un peon rival, este ultimo puede capturarlo en la jugada inmediatamente siguiente.

4. Coronacion: Cuando un peon alcanza la ultima fila del tablero, debes elegir transformarlo en Dama, Torre, Alfil o Caballo.

5. Tablas: La partida termina en empate por ahogado (sin jugadas legales y sin jaque), regla de 50 jugadas, material insuficiente o triple repeticion de posicion."
autowrap_mode = 3

[node name="BtnCloseRules" type="Button" parent="CenterContainer/PanelContainer/VBoxContainer"]
